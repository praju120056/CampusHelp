# Copy to .env and fill in. Never commit .env.

# Database (SQLite for the laptop demo; Postgres URL works too)
DATABASE_URL=sqlite:///./educrew.db

# Auth: use a long random string in .env
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=12

# AI triage (Google Gemini). Confirm the exact model ID in Google AI Studio.
# Leave GEMINI_API_KEY empty to use the rule-based fallback only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Email (Gmail with an app password). Leave SMTP_HOST empty to write all mail to the outbox page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Base URL printed into QR codes and email links: the laptop's Wi-Fi address and frontend port
PUBLIC_BASE_URL=http://192.168.1.10:3000

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Demo mode: ticket deadlines shrink from hours to minutes
DEMO_MODE=false
